# Nakili kwenda server kama /etc/designbora/designbora.env (chmod 600), jaza thamani.
# USIWEKE faili lenye thamani halisi kwenye git.

SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://localhost:5432/designbora
DB_USERNAME=designbora
DB_PASSWORD=                # nenosiri JIPYA na imara la server (si la kompyuta yako)

JWT_SECRET=                 # tengeneza: openssl rand -hex 64

# Admin panel (Next.js) inaita backend ikiwa server ileile -> 127.0.0.1
ADMIN_ALLOWED_IPS=127.0.0.1

CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_CHECKSUM_KEY=

FIREBASE_CREDENTIALS=/etc/designbora/firebase-service-account.json
STORAGE_PATH=/var/lib/designbora/storage
